{
  "name": "ava-player",
  "version": "0.2.0",
  "description": "AVA five-output presentation player for Windows",
  "author": "AVA",
  "license": "UNLICENSED",
  "private": true,
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64",
    "smoke": "node tests/electron-smoke.cjs",
    "dist:win:dir": "electron-builder --win --x64 --dir",
    "installer:nsis": "node scripts/build-linux-installer.cjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "ir.avagroups.player",
    "productName": "AVA Player",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/ava.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AVA Player"
    }
  }
}
